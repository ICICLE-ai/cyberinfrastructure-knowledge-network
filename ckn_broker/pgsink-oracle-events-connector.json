{
  "name": "PgSinkConnectorCameraTraps",
  "config": {
    "topics": "oracle-events",
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "connection.url": "jdbc:postgresql://patra-postgres:5432/patra",
    "connection.user": "patra",
    "connection.password": "patra-dev-password",
    "table.name.format": "events",
    "insert.mode": "upsert",
    "pk.mode": "record_value",
    "pk.fields": "uuid",
    "auto.create": "false",
    "auto.evolve": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "key.converter.schemas.enable": false,
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": true,
    "errors.tolerance": "all",
    "errors.log.enable": true,
    "errors.log.include.messages": true,
    "transforms": "RenameUUID",
    "transforms.RenameUUID.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
    "transforms.RenameUUID.renames": "UUID:uuid"
  }
}
